# Copiar a .env. No se necesita LLM para ingerir, consultar catálogo o recuperar sesiones.
TUTOR_DATA_DIR=data
TUTOR_CORPUS_PATH=corpus/demo.json
TUTOR_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Revisión exacta verificada en el repositorio del modelo; véase README.
TUTOR_EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
TUTOR_LLM_PROVIDER=disabled
# openai_compatible: URL base terminada en /v1. ollama: http://localhost:11434
# transformers_local: modelo de Hugging Face en el mismo proceso, sin URL ni clave.
TUTOR_LLM_BASE_URL=http://localhost:11434
# Elegir un identificador existente mediante `tutor models`; no hay modelo LLM predeterminado.
TUTOR_LLM_MODEL=
TUTOR_LLM_REVISION=
TUTOR_LOCAL_DTYPE=float32
TUTOR_LOCAL_THREADS=8
TUTOR_LLM_API_KEY=
TUTOR_LLM_TIMEOUT=60
TUTOR_LLM_RETRIES=2
TUTOR_LLM_TEMPERATURE=0.2
TUTOR_LLM_MAX_TOKENS=1000
# json_schema si el servidor admite restricciones JSON Schema; json_object para compatibilidad básica.
TUTOR_LLM_RESPONSE_FORMAT=json_object
TUTOR_MAX_HINT_LEVEL=3
TUTOR_EXECUTION_ENABLED=false
# Imagen local de confianza fijada por digest sha256; no se descarga automáticamente.
TUTOR_DOCKER_IMAGE=
